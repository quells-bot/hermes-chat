# Environment file for hermes-chat.service, installed as /etc/hermes-chat/env.
# Plain NAME=value lines: no quotes, no export, comments on their own lines.
# hermes-chat-upgrade and hermes-chat-admin read this file without a shell and
# keep quotes, so do not quote values.

HERMES_CHAT_DB_PATH=/var/lib/hermes-chat/chat.db
HERMES_CHAT_HTTP_ADDR=:443
HERMES_CHAT_TLS_MODE=autocert
HERMES_CHAT_TLS_DOMAIN=chat.example.com

# The remaining settings are shown at their defaults. Uncomment to change one.

# Where issued certificates and the account key are cached. Default: certs beside the database.
# A directory outside /var/lib/hermes-chat also needs ReadWritePaths= in the unit.
# HERMES_CHAT_TLS_CACHE_DIR=/var/lib/hermes-chat/certs

# Where attachment bodies are stored. Default: attachments beside the database.
# A directory outside /var/lib/hermes-chat also needs ReadWritePaths= in the unit.
# HERMES_CHAT_ATTACHMENTS_DIR=/var/lib/hermes-chat/attachments

# debug, info, warn, or error.
# HERMES_CHAT_LOG_LEVEL=info

# debug, release, or test.
# HERMES_CHAT_GIN_MODE=release

# The Secure attribute on the session cookie. Keep true when serving HTTPS.
# HERMES_CHAT_COOKIE_SECURE=true

# pprof listener; must be a loopback address.
# HERMES_CHAT_DEBUG_ADDR=127.0.0.1:6060

# Comma-separated IPs or CIDRs whose X-Forwarded-For is believed. Only behind a reverse proxy.
# HERMES_CHAT_TRUSTED_PROXIES=
